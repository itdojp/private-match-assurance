{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/private-match-assurance-package.v0.1.schema.json",
  "title": "Private Match internal Assurance package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_status",
    "execution_mode",
    "integration_profile",
    "ae_framework",
    "adapter",
    "input_producer_package_digest",
    "evidence_records",
    "evidence_record_refs",
    "producer_inventory",
    "external_tool_inventory",
    "native_ae_summary_projection",
    "producer_gate_judgment",
    "native_ae_judgment",
    "automated_judgment",
    "human_approval",
    "required_gate_results",
    "optional_gate_results",
    "status_counts",
    "limitations",
    "lifecycle_boundary",
    "report_digests",
    "assurance_content_digest",
    "package_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact_status": {
      "enum": [
        "test-only",
        "private-candidate"
      ]
    },
    "integration_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "const": "private-match-ae-assurance"
        },
        "version": {
          "const": "0.1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "ae_framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "package_name",
        "package_version",
        "source_tree_digest",
        "native_projection_digest"
      ],
      "properties": {
        "repository": {
          "const": "itdojp/ae-framework"
        },
        "commit": {
          "const": "bba9b6846608359b87ed5393cb208e321f3ba8af"
        },
        "package_name": {
          "const": "ae-framework"
        },
        "package_version": {
          "const": "1.0.0"
        },
        "source_tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "native_projection_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "implementation_digest"
      ],
      "properties": {
        "id": {
          "const": "private-match-assurance/ae-framework-adapter"
        },
        "version": {
          "const": "0.1"
        },
        "implementation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "input_producer_package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_records": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "https://itdo.jp/schemas/private-match/assurance/evidence-item-0.1.json"
      },
      "maxItems": 5,
      "uniqueItems": true
    },
    "evidence_record_refs": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "record_digest",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^PM-EVIDENCE-[0-9]{4,}$"
          },
          "record_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          }
        }
      },
      "maxItems": 5
    },
    "producer_inventory": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "producer_type",
          "producer_id",
          "producer_version",
          "tool_role_id",
          "tool_id",
          "tool_version",
          "tool_implementation_digest",
          "tool_binding_digest",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^PM-EVIDENCE-[0-9]{4,}$"
          },
          "producer_type": {
            "enum": [
              "ci",
              "formal-tool",
              "test-runner",
              "security-tool",
              "human-review"
            ]
          },
          "producer_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_version": {
            "type": "string",
            "minLength": 1
          },
          "tool_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "tool_version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z._+-]{0,31})$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          },
          "tool_role_id": {
            "enum": [
              "PMAE-CI-PIPELINE-V0-1",
              "PMAE-CONFORMANCE-RUNNER-V0-1",
              "PMAE-FORMAL-TOOL-V0-1",
              "PMAE-SECURITY-TOOL-V0-1",
              "PMAE-HUMAN-REVIEW-V0-1"
            ]
          },
          "tool_implementation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "tool_binding_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "maxItems": 5
    },
    "external_tool_inventory": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_role_id",
          "producer_type",
          "requirement",
          "mode",
          "tool_id",
          "tool_version",
          "tool_implementation_digest",
          "input_contract",
          "output_contract",
          "limitations",
          "tool_binding_digest"
        ],
        "properties": {
          "tool_role_id": {
            "enum": [
              "PMAE-CI-PIPELINE-V0-1",
              "PMAE-CONFORMANCE-RUNNER-V0-1",
              "PMAE-FORMAL-TOOL-V0-1",
              "PMAE-SECURITY-TOOL-V0-1",
              "PMAE-HUMAN-REVIEW-V0-1"
            ]
          },
          "producer_type": {
            "enum": [
              "ci",
              "formal-tool",
              "test-runner",
              "security-tool",
              "human-review"
            ]
          },
          "requirement": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "mode": {
            "enum": [
              "fixture-test",
              "private-candidate"
            ]
          },
          "tool_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "tool_version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z._+-]{0,31})$"
          },
          "tool_implementation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "input_contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "output_contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            }
          },
          "tool_binding_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "native_ae_summary_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at",
        "summary",
        "lane_coverage",
        "claims",
        "warning_codes"
      ],
      "properties": {
        "schema_version": {
          "const": "assurance-summary/v1-safe-projection"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claimCount",
            "satisfiedClaims",
            "warningClaims",
            "claimsMissingRequiredLanes",
            "claimsMissingRequiredEvidenceKinds",
            "unlinkedCounterexamples",
            "warningCount"
          ],
          "properties": {
            "claimCount": {
              "type": "integer",
              "minimum": 0
            },
            "satisfiedClaims": {
              "type": "integer",
              "minimum": 0
            },
            "warningClaims": {
              "type": "integer",
              "minimum": 0
            },
            "claimsMissingRequiredLanes": {
              "type": "integer",
              "minimum": 0
            },
            "claimsMissingRequiredEvidenceKinds": {
              "type": "integer",
              "minimum": 0
            },
            "unlinkedCounterexamples": {
              "type": "integer",
              "minimum": 0
            },
            "warningCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lane_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec",
            "behavior",
            "adversarial",
            "model",
            "proof",
            "runtime"
          ],
          "properties": {
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredClaims",
                "observedClaims"
              ],
              "properties": {
                "requiredClaims": {
                  "type": "integer",
                  "minimum": 0
                },
                "observedClaims": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "behavior": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredClaims",
                "observedClaims"
              ],
              "properties": {
                "requiredClaims": {
                  "type": "integer",
                  "minimum": 0
                },
                "observedClaims": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "adversarial": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredClaims",
                "observedClaims"
              ],
              "properties": {
                "requiredClaims": {
                  "type": "integer",
                  "minimum": 0
                },
                "observedClaims": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredClaims",
                "observedClaims"
              ],
              "properties": {
                "requiredClaims": {
                  "type": "integer",
                  "minimum": 0
                },
                "observedClaims": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "proof": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredClaims",
                "observedClaims"
              ],
              "properties": {
                "requiredClaims": {
                  "type": "integer",
                  "minimum": 0
                },
                "observedClaims": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredClaims",
                "observedClaims"
              ],
              "properties": {
                "requiredClaims": {
                  "type": "integer",
                  "minimum": 0
                },
                "observedClaims": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "status",
              "required_lanes",
              "observed_lanes",
              "missing_lanes",
              "required_evidence_kinds",
              "observed_evidence_kinds",
              "missing_evidence_kinds",
              "warning_codes"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "satisfied",
                  "warning"
                ]
              },
              "required_lanes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "observed_lanes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "missing_lanes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required_evidence_kinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "observed_evidence_kinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "missing_evidence_kinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "warning_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "warning_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "automated_judgment": {
      "$ref": "https://itdo.jp/schemas/private-match/assurance/assurance-automated-judgment.v0.1.schema.json"
    },
    "human_approval": {
      "$ref": "https://itdo.jp/schemas/private-match/assurance/assurance-human-approval.v0.1.schema.json"
    },
    "required_gate_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "requirement",
          "status",
          "gate_state",
          "limitation"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "const": "required"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          },
          "gate_state": {
            "enum": [
              "satisfied",
              "blocked"
            ]
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 2,
      "uniqueItems": true
    },
    "optional_gate_results": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "requirement",
          "status",
          "gate_state",
          "limitation"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "const": "optional"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          },
          "gate_state": {
            "enum": [
              "satisfied",
              "visible-nonblocking"
            ]
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "skip",
        "unsupported",
        "timeout",
        "tool-error"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "tool-error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lifecycle_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_lifecycle",
        "public_export_eligible",
        "publication_approval",
        "public_export_invoked"
      ],
      "properties": {
        "maximum_lifecycle": {
          "enum": [
            "validated",
            "sanitized"
          ]
        },
        "public_export_eligible": {
          "const": false
        },
        "publication_approval": {
          "const": "not-created"
        },
        "public_export_invoked": {
          "const": false
        }
      }
    },
    "report_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_model_digest",
        "markdown_model_digest"
      ],
      "properties": {
        "json_model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "markdown_model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      }
    },
    "assurance_content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "execution_mode": {
      "enum": [
        "fixture-test",
        "private-candidate"
      ]
    },
    "native_ae_judgment": {
      "$ref": "https://itdo.jp/schemas/private-match/assurance/ae-native-judgment.v0.1.schema.json"
    },
    "producer_gate_judgment": {
      "$ref": "https://itdo.jp/schemas/private-match/assurance/assurance-producer-gate-judgment.v0.1.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "fixture-test"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_status": {
            "const": "test-only"
          },
          "human_approval": {
            "properties": {
              "state": {
                "enum": [
                  "not-applicable-test-only",
                  "required-not-provided"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "private-candidate"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_status": {
            "const": "private-candidate"
          }
        }
      }
    }
  ],
  "description": "Private/internal Assurance package reusing Evidence Schema 0.1; it is public-export-ineligible and does not establish proof, certification, or readiness."
}
