{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/ae-assurance-tool-inventory.v0.1.schema.json",
  "title": "Private Match Assurance tool inventory v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_status",
    "inventory_id",
    "tools",
    "inventory_digest",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact_status": {
      "const": "draft"
    },
    "inventory_id": {
      "const": "private-match-ae-assurance-tools/0.1"
    },
    "tools": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "producer_type",
          "requirement",
          "input_contract",
          "output_contract",
          "timeout_policy",
          "absence_behavior",
          "status_mappings",
          "evidence_requirement_id",
          "limitations"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_type": {
            "enum": [
              "ci",
              "formal-tool",
              "test-runner",
              "security-tool",
              "human-review"
            ]
          },
          "requirement": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "input_contract": {
            "type": "string",
            "minLength": 1
          },
          "output_contract": {
            "type": "string",
            "minLength": 1
          },
          "timeout_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "limit"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "deterministic-work-units",
                  "subprocess-seconds",
                  "not-applicable"
                ]
              },
              "limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          },
          "absence_behavior": {
            "enum": [
              "unsupported-blocked",
              "tool-error-blocked",
              "skip-visible",
              "unsupported-visible"
            ]
          },
          "status_mappings": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw_producer_status",
                "normalized_evidence_status",
                "producer_type",
                "tool_id",
                "rationale",
                "required_limitation"
              ],
              "properties": {
                "raw_producer_status": {
                  "enum": [
                    "pass",
                    "fail",
                    "skip",
                    "unsupported",
                    "timeout",
                    "tool-error"
                  ]
                },
                "normalized_evidence_status": {
                  "enum": [
                    "pass",
                    "fail",
                    "skip",
                    "unsupported",
                    "timeout",
                    "tool-error"
                  ]
                },
                "producer_type": {
                  "enum": [
                    "ci",
                    "formal-tool",
                    "test-runner",
                    "security-tool",
                    "human-review"
                  ]
                },
                "tool_id": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "required_limitation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidence_requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "description": "Closed policy-role inventory for required/optional behavior and exact six-status preservation; execution-tool provenance is supplied separately by a mode-specific binding."
}
