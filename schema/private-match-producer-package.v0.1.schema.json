{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/private-match-producer-package.v0.1.schema.json",
  "title": "Private Match producer package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "artifact_status",
    "mode",
    "created_at",
    "validation_event",
    "source_revision_digest",
    "subject",
    "protocol_conformance_authority",
    "tool_bindings",
    "records",
    "limitations",
    "package_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^PMAE-PRODUCER-[A-Z0-9-]+-V0-1$"
    },
    "artifact_status": {
      "enum": [
        "test-only",
        "private-candidate"
      ]
    },
    "mode": {
      "enum": [
        "fixture-test",
        "private-candidate"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "producer_type",
          "producer_id",
          "producer_version",
          "tool_id",
          "tool_identity",
          "tool_version",
          "tool_implementation_digest",
          "protocol_suite_digest",
          "protocol_case_digest",
          "protocol_input_digest",
          "product_implementation_digest",
          "product_artifact_digest",
          "product_output_digest",
          "status",
          "limitations",
          "test_only",
          "retention_classification",
          "public_export_eligibility",
          "started_at",
          "completed_at",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^PM-EVIDENCE-[0-9]{4,}$"
          },
          "producer_type": {
            "enum": [
              "ci",
              "formal-tool",
              "test-runner",
              "security-tool",
              "human-review"
            ]
          },
          "producer_id": {
            "enum": [
              "synthetic-ci-producer",
              "synthetic-formal-tool-producer",
              "synthetic-test-runner-producer",
              "synthetic-security-tool-producer",
              "synthetic-human-review-producer",
              "private-match-product-ci",
              "private-match-product-formal-tool",
              "private-match-product-test-runner",
              "private-match-product-security-tool",
              "private-match-product-human-review"
            ]
          },
          "producer_version": {
            "type": "string",
            "minLength": 1
          },
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "tool_implementation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "protocol_suite_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Must exactly equal the package Protocol/conformance authority suite digest for every producer role."
          },
          "protocol_case_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "protocol_input_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "product_implementation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "product_artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "product_output_digest": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "test_only": {
            "type": "boolean"
          },
          "retention_classification": {
            "enum": [
              "synthetic-public-fixture",
              "private-assurance-retained"
            ]
          },
          "public_export_eligibility": {
            "const": false
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "tool_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "maxItems": 5,
      "description": "Exactly one record for each reviewed producer role; every record is bound to the package's one reviewed conformance-suite authority."
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "identifier": {
          "enum": [
            "synthetic-private-match-product",
            "private-match-product"
          ]
        },
        "type": {
          "const": "source-revision"
        },
        "version": {
          "const": "0.1"
        }
      },
      "required": [
        "type",
        "identifier",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "tool_bindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "https://itdo.jp/schemas/private-match/assurance/ae-assurance-tool-binding.v0.1.schema.json"
      }
    },
    "protocol_conformance_authority": {
      "$ref": "https://itdo.jp/schemas/private-match/assurance/private-match-protocol-authorities.v0.1.schema.json#/$defs/binding"
    },
    "validation_event": {
      "additionalProperties": false,
      "properties": {
        "validated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "validated_at"
      ],
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "fixture-test"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_status": {
            "const": "test-only"
          },
          "records": {
            "items": {
              "properties": {
                "retention_classification": {
                  "const": "synthetic-public-fixture"
                },
                "test_only": {
                  "const": true
                }
              }
            }
          },
          "subject": {
            "properties": {
              "identifier": {
                "const": "synthetic-private-match-product"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "private-candidate"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_status": {
            "const": "private-candidate"
          },
          "package_id": {
            "const": "PMAE-PRODUCER-PRIVATE-CANDIDATE-V0-1"
          },
          "records": {
            "items": {
              "properties": {
                "retention_classification": {
                  "const": "private-assurance-retained"
                },
                "test_only": {
                  "const": false
                }
              }
            }
          },
          "subject": {
            "properties": {
              "identifier": {
                "const": "private-match-product"
              }
            }
          }
        }
      }
    }
  ],
  "description": "Strict single-source-revision, digest-only producer metadata boundary. The package subject digest is the sole source-revision authority; raw Product state, private input, identities, logs, secrets, and disclosure payloads are forbidden."
}
