{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/private-match-producer-package.v0.1.schema.json",
  "title": "Private Match producer package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "artifact_status",
    "mode",
    "created_at",
    "source_revision_digest",
    "records",
    "limitations",
    "package_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^PMAE-PRODUCER-[A-Z0-9-]+-V0-1$"
    },
    "artifact_status": {
      "enum": [
        "test-only",
        "private-candidate"
      ]
    },
    "mode": {
      "enum": [
        "fixture-test",
        "private-candidate"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "producer_type",
          "producer_id",
          "producer_version",
          "tool_id",
          "tool_version",
          "tool_implementation_digest",
          "source_revision_digest",
          "protocol_suite_digest",
          "protocol_case_digest",
          "protocol_input_digest",
          "product_implementation_digest",
          "product_artifact_digest",
          "product_output_digest",
          "status",
          "limitations",
          "test_only",
          "retention_classification",
          "public_export_eligibility",
          "started_at",
          "completed_at",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^PM-EVIDENCE-[0-9]{4,}$"
          },
          "producer_type": {
            "enum": [
              "ci",
              "formal-tool",
              "test-runner",
              "security-tool",
              "human-review"
            ]
          },
          "producer_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_version": {
            "type": "string",
            "minLength": 1
          },
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "tool_implementation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_revision_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "protocol_suite_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "protocol_case_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "protocol_input_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "product_implementation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "product_artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "product_output_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test_only": {
            "type": "boolean"
          },
          "retention_classification": {
            "enum": [
              "synthetic-public-fixture",
              "private-assurance-retained"
            ]
          },
          "public_export_eligibility": {
            "const": false
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "fixture-test"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_status": {
            "const": "test-only"
          },
          "records": {
            "items": {
              "properties": {
                "test_only": {
                  "const": true
                },
                "retention_classification": {
                  "const": "synthetic-public-fixture"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "private-candidate"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_status": {
            "const": "private-candidate"
          },
          "records": {
            "items": {
              "properties": {
                "retention_classification": {
                  "const": "private-assurance-retained"
                }
              }
            }
          }
        }
      }
    }
  ],
  "description": "Digest-only producer metadata boundary; raw Product state, private input, identities, logs, secrets, and disclosure payloads are forbidden."
}
