{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/evidence-export-fixture-catalog-0.1.json",
  "title": "Private Match synthetic Evidence export fixture catalog v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_status", "fixtures"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "artifact_status": {"const": "test-only"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "relative_input_path", "candidate_digest", "artifact_status", "synthetic_review_digests"],
        "properties": {
          "fixture_id": {"type": "string", "pattern": "^FIXTURE-[A-Z0-9-]{4,64}$"},
          "relative_input_path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$"},
          "candidate_digest": {"$ref": "#/$defs/digest"},
          "artifact_status": {"const": "test-only"},
          "synthetic_review_digests": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/digest"}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
