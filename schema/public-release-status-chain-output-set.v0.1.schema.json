{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/public-release-status-chain-output-set.v0.1.schema.json",
  "title": "Exact public release status-chain output set v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_status", "trust_domain_id", "exact_paths", "files", "self", "chain_tree_digest", "chain_manifest_digest", "latest_revision", "latest_status_set_digest", "output_set_digest"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[A-Za-z0-9._/-]+$"}
  },
  "properties": {
    "schema_version": {"const": "0.1"},
    "artifact_status": {"const": "test-only"},
    "trust_domain_id": {"const": "itdo-private-match-assurance-fixture-v0.1"},
    "exact_paths": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "file_digest", "size", "role"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "file_digest": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 1, "maximum": 8388608},
          "role": {"enum": ["status-chain-manifest", "status-set", "status-signature"]}
        }
      }
    },
    "self": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest_field"],
      "properties": {
        "path": {"const": "public-release-status-chain-output-set.v0.1.json"},
        "digest_field": {"const": "output_set_digest"}
      }
    },
    "chain_tree_digest": {"$ref": "#/$defs/digest"},
    "chain_manifest_digest": {"$ref": "#/$defs/digest"},
    "latest_revision": {"type": "integer", "minimum": 1},
    "latest_status_set_digest": {"$ref": "#/$defs/digest"},
    "output_set_digest": {"$ref": "#/$defs/digest"}
  }
}
