{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/public-release-status-chain-manifest.v0.1.schema.json",
  "title": "Signed public release status-chain manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "artifact_status",
    "trust_domain_id",
    "status_signing_profile",
    "status_signing_key_id",
    "revisions",
    "latest_revision",
    "latest_status_set_digest",
    "generated_at",
    "chain_tree_digest",
    "chain_manifest_digest",
    "limitations"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[A-Za-z0-9._/-]+$"}
  },
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "public-release-status-chain-manifest"},
    "artifact_status": {"const": "test-only"},
    "trust_domain_id": {"const": "itdo-private-match-assurance-fixture-v0.1"},
    "status_signing_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "algorithm", "payload_type"],
      "properties": {
        "id": {"const": "private-match-public-release-signing"},
        "version": {"const": "0.1"},
        "algorithm": {"const": "ed25519-rfc8032"},
        "payload_type": {"const": "application/vnd.itdo.private-match.assurance-release-status-set.v0.1+json"}
      }
    },
    "status_signing_key_id": {"$ref": "#/$defs/digest"},
    "revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "generated_at", "status_set_path", "status_set_digest", "status_set_file_digest", "status_signature_path", "status_signature_digest", "previous_status_set_digest"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "generated_at": {"type": "string", "format": "date-time"},
          "status_set_path": {"$ref": "#/$defs/path"},
          "status_set_digest": {"$ref": "#/$defs/digest"},
          "status_set_file_digest": {"$ref": "#/$defs/digest"},
          "status_signature_path": {"$ref": "#/$defs/path"},
          "status_signature_digest": {"$ref": "#/$defs/digest"},
          "previous_status_set_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
        }
      }
    },
    "latest_revision": {"type": "integer", "minimum": 1},
    "latest_status_set_digest": {"$ref": "#/$defs/digest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "chain_tree_digest": {"$ref": "#/$defs/digest"},
    "chain_manifest_digest": {"$ref": "#/$defs/digest"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
