{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdo.jp/schemas/private-match/assurance/public-release-verification-profile.v0.1.schema.json",
  "title": "Offline public release verification profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_status",
    "profile_id",
    "profile_version",
    "trust_input",
    "network",
    "verification_time",
    "claim_evaluation_policy",
    "stages",
    "claim_result_vocabulary",
    "overall_status_vocabulary",
    "exit_codes",
    "revocation_policy",
    "status_authority",
    "limitations",
    "profile_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact_status": {
      "const": "test-only"
    },
    "profile_id": {
      "const": "private-match-public-release-verification"
    },
    "profile_version": {
      "const": "0.1"
    },
    "trust_input": {
      "const": "external-public-signing-trust-root"
    },
    "network": {
      "const": "forbidden"
    },
    "verification_time": {
      "const": "required"
    },
    "claim_evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_time_applies_to_claim_validity",
        "claim_validity_interval",
        "positive_evidence_statuses",
        "supporting_evidence_lifecycles",
        "non_supporting_evidence_lifecycles",
        "supporting_assumption_statuses",
        "invalidated_assumption_result",
        "expired_assumption_result"
      ],
      "properties": {
        "verification_time_applies_to_claim_validity": {
          "const": true
        },
        "claim_validity_interval": {
          "const": "inclusive"
        },
        "positive_evidence_statuses": {
          "const": [
            "pass"
          ]
        },
        "supporting_evidence_lifecycles": {
          "const": [
            "collected",
            "validated",
            "sanitized",
            "published"
          ]
        },
        "non_supporting_evidence_lifecycles": {
          "const": [
            "superseded",
            "withdrawn"
          ]
        },
        "supporting_assumption_statuses": {
          "const": [
            "active"
          ]
        },
        "invalidated_assumption_result": {
          "const": "not-supported"
        },
        "expired_assumption_result": {
          "const": "not-evaluated"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "enum": [
          "signature",
          "trust",
          "structure",
          "bundle-digest-closure",
          "status-chain-digest-closure",
          "static-report-linkage",
          "release-lifecycle",
          "claims",
          "overall"
        ]
      },
      "minItems": 9,
      "uniqueItems": true
    },
    "claim_result_vocabulary": {
      "type": "array",
      "items": {
        "enum": [
          "supported",
          "supported-with-assumptions",
          "not-supported",
          "not-evaluated",
          "invalid-reference"
        ]
      },
      "minItems": 5,
      "uniqueItems": true
    },
    "overall_status_vocabulary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 15,
      "uniqueItems": true
    },
    "exit_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "classification"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "classification": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 6
    },
    "revocation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted_timestamp",
        "compromise_applies_to_all_key_signatures",
        "bundle_signed_at_is_not_trusted_time"
      ],
      "properties": {
        "trusted_timestamp": {
          "const": false
        },
        "compromise_applies_to_all_key_signatures": {
          "const": true
        },
        "bundle_signed_at_is_not_trusted_time": {
          "const": true
        }
      }
    },
    "status_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "complete_chain_required", "latest_declared_revision_applied", "global_freshness_proven", "status_signing_key_authority"],
      "properties": {
        "input": {"const": "external-signed-status-chain"},
        "complete_chain_required": {"const": true},
        "latest_declared_revision_applied": {"const": true},
        "global_freshness_proven": {"const": false},
        "status_signing_key_authority": {"const": "external-trust-root-only"}
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
